---
import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
---

<Layout title="Página no encontrada | Kindora">
  <div class="mx-auto max-w-4xl px-4 py-20 text-center">
    <EmptyState
      icon="search"
      title="Actividad o página no encontrada"
      description="La actividad que estás buscando pudo haber sido eliminada, pausada o la dirección no es correcta."
      actionText="Explorar todas las actividades"
      actionHref="/explorar"
    />
  </div>
</Layout>
