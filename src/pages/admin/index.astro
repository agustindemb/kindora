---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { analyticsService } from '../../services/analyticsService';
import { db } from '../../lib/db/client';
import { organizations, organizationStats, user, organizationLogs } from '../../lib/db/schema';
import * as schema from '../../lib/db/schema';
import { eq, and, isNull, sql, desc } from 'drizzle-orm';
import { ShieldCheck, CheckCircle2, XCircle, Users, Building2, Calendar, FileText, ExternalLink, Trash2, ArrowUpRight, Search, Shield, UserCheck, Eye, BarChart3, TrendingUp, Activity } from 'lucide-astro';

const currentUser = Astro.locals.user;

if (!currentUser || (currentUser.role !== 'admin' && currentUser.realRole !== 'admin')) {
  return Astro.redirect('/login');
}

// Read active tab from query params
const activeTabParam = Astro.url.searchParams.get('tab') || 'analytics';

// Fetch analytics metrics
const analyticsMetrics = await analyticsService.getAdminMetrics();

let stats = {
  usersCount: 0,
  orgsCount: 0,
  actsCount: 0,
};

let unverifiedOrgs: any[] = [];
let pendingVerificationsList: any[] = [];
let allUsersList: any[] = [];
let allOrgsList: any[] = [];
let allActivitiesList: any[] = [];

try {
  // 0. Auto cleanup existing orphaned activities from soft-deleted organizations
  try {
    await db.update(schema.activities)
      .set({ deletedAt: new Date() })
      .where(sql`${schema.activities.organizationId} IN (SELECT id FROM organizations WHERE "deletedAt" IS NOT NULL) AND ${schema.activities.deletedAt} IS NULL`);
  } catch (e) {}

  // 1. Fetch counts
  const usersRes = await db.select({ count: sql`count(${user.id})::int` }).from(user);
  const orgsRes = await db.select({ count: sql`count(${organizations.id})::int` }).from(organizations).where(isNull(organizations.deletedAt));
  const actsRes = await db
    .select({ count: sql`count(${schema.activities.id})::int` })
    .from(schema.activities)
    .innerJoin(organizations, eq(schema.activities.organizationId, organizations.id))
    .where(and(isNull(schema.activities.deletedAt), isNull(organizations.deletedAt)));
  
  stats = {
    usersCount: usersRes[0]?.count || 0,
    orgsCount: orgsRes[0]?.count || 0,
    actsCount: actsRes[0]?.count || 0,
  };

  // 2. Fetch full lists for inspection
  allUsersList = await db
    .select()
    .from(user)
    .orderBy(desc(user.createdAt));

  allOrgsList = await db
    .select()
    .from(organizations)
    .where(isNull(organizations.deletedAt))
    .orderBy(desc(organizations.createdAt));

  allActivitiesList = await db
    .select({
      id: schema.activities.id,
      title: schema.activities.title,
      slug: schema.activities.slug,
      status: schema.activities.status,
      startsAt: schema.activities.startsAt,
      createdAt: schema.activities.createdAt,
      price: schema.activities.price,
      orgName: organizations.name,
      orgSlug: organizations.slug,
      categoryName: schema.categories.name,
    })
    .from(schema.activities)
    .innerJoin(organizations, eq(schema.activities.organizationId, organizations.id))
    .leftJoin(schema.categories, eq(schema.activities.categoryId, schema.categories.id))
    .where(and(isNull(schema.activities.deletedAt), isNull(organizations.deletedAt)))
    .orderBy(desc(schema.activities.createdAt));

  // 3. Fetch unverified organizations
  unverifiedOrgs = await db
    .select()
    .from(organizations)
    .where(and(eq(organizations.verificationLevel, 'none'), isNull(organizations.deletedAt)));

  // 4. Fetch logs of verification requests (only for orgs that are still unverified)
  const logs = await db
    .select({
      log: organizationLogs,
      org: organizations,
      u: user
    })
    .from(organizationLogs)
    .innerJoin(organizations, eq(organizationLogs.organizationId, organizations.id))
    .innerJoin(user, eq(organizationLogs.userId, user.id))
    .where(
      and(
        eq(organizationLogs.action, 'verification_requested'),
        eq(organizations.verificationLevel, 'none'),
        isNull(organizations.deletedAt)
      )
    )
    .orderBy(desc(organizationLogs.createdAt));

  pendingVerificationsList = logs.map(l => {
    let details = { dni: '', phone: '', notes: '' };
    try {
      details = JSON.parse(l.log.details || '{}');
    } catch(e){}
    return {
      ...l.log,
      orgName: l.org.name,
      orgSlug: l.org.slug,
      userName: l.u.name,
      details
    };
  });
} catch(e) {
  console.warn("DB query error or fallback mock used for admin:", e);
  const { mockOrganizations, mockActivities } = await import('../../lib/db/mocks');
  unverifiedOrgs = mockOrganizations.filter(o => o.verificationLevel === 'none');
  stats = {
    usersCount: 3,
    orgsCount: mockOrganizations.length,
    actsCount: mockActivities.length,
  };
  
  allUsersList = [
    { id: 'usr_admin', name: 'Admin Kindora', email: 'agustin@proasc.com', role: 'admin', createdAt: new Date() },
    { id: 'usr_org', name: 'María Gómez', email: 'organizador@kindora.com', role: 'organizer', createdAt: new Date() },
    { id: 'usr_part', name: 'Juan Pérez', email: 'participante@kindora.com', role: 'participant', createdAt: new Date() }
  ];
  allOrgsList = mockOrganizations;
  allActivitiesList = mockActivities.map(a => ({
    id: a.id,
    title: a.title,
    slug: a.slug,
    status: a.status,
    startsAt: a.startsAt,
    createdAt: a.createdAt,
    price: a.price,
    orgName: 'Organización Kindora',
    orgSlug: 'org-kindora',
    categoryName: 'General'
  }));

  pendingVerificationsList = [
    {
      id: 'mock-req-1',
      organizationId: 'org-4',
      orgName: 'Patitas de Palermo',
      orgSlug: 'patitas-palermo',
      userName: 'María Gómez',
      createdAt: new Date(),
      details: { dni: '38.234.567', phone: '+5491133334444', notes: 'Personería jurídica en trámite, adjunto estatuto provisorio.' }
    }
  ];
}

// Handle POST actions: Approve/Reject Verification requests & Moderation
let successMsg = '';
let errorMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action');

    if (action === 'approve') {
      const orgId = formData.get('organizationId') as string;
      const level = formData.get('level') as string || 'verified';
      
      await db.update(organizations).set({
        verificationLevel: level,
        verifiedAt: new Date(),
        verifiedBy: currentUser.id
      }).where(eq(organizations.id, orgId));

      await db.update(schema.activities).set({
        status: 'published'
      }).where(and(eq(schema.activities.organizationId, orgId), eq(schema.activities.status, 'pending_review')));

      // Clean up pending verification_requested logs for this org
      await db.delete(organizationLogs).where(
        and(
          eq(organizationLogs.organizationId, orgId),
          eq(organizationLogs.action, 'verification_requested')
        )
      );

      await db.insert(schema.organizationLogs).values({
        organizationId: orgId,
        userId: currentUser.id,
        action: 'verified',
        details: JSON.stringify({ level, verifiedAt: new Date() }),
      });

      // Send email notification to organization
      const targetOrgs = await db.select().from(organizations).where(eq(organizations.id, orgId)).limit(1);
      if (targetOrgs.length > 0 && targetOrgs[0].email) {
        try {
          const { emailService } = await import('../../services/emailService');
          await emailService.sendOrganizationApproved(targetOrgs[0].email, targetOrgs[0].name);
        } catch(e){}
      }

      successMsg = `Organización aprobada con nivel: ${level.toUpperCase()}. Sus actividades pendientes han sido publicadas.`;
      return Astro.redirect('/admin?tab=verifications');

    } else if (action === 'reject') {
      const orgId = formData.get('organizationId') as string;
      await db.delete(organizationLogs).where(
        and(
          eq(organizationLogs.organizationId, orgId),
          eq(organizationLogs.action, 'verification_requested')
        )
      );
      
      successMsg = 'Solicitud de verificación rechazada.';
      return Astro.redirect('/admin?tab=verifications');

    } else if (action === 'update_user_role') {
      const targetUserId = formData.get('userId') as string;
      const newRole = formData.get('role') as string;
      
      await db.update(user).set({
        role: newRole,
        updatedAt: new Date()
      }).where(eq(user.id, targetUserId));

      successMsg = `Rol de usuario actualizado correctamente a ${newRole.toUpperCase()}.`;
      return Astro.redirect('/admin?tab=users');

    } else if (action === 'delete_activity') {
      const actId = formData.get('activityId') as string;
      await db.update(schema.activities).set({
        deletedAt: new Date()
      }).where(eq(schema.activities.id, actId));

      successMsg = 'Actividad eliminada correctamente.';
      return Astro.redirect('/admin?tab=activities');

    } else if (action === 'delete_user') {
      const targetUserId = formData.get('userId') as string;
      if (targetUserId === currentUser.id) {
        throw new Error('No podés eliminar tu propia cuenta de administrador.');
      }
      await db.update(user).set({
        deletedAt: new Date(),
        updatedAt: new Date()
      }).where(eq(user.id, targetUserId));

      successMsg = 'Usuario eliminado correctamente.';
      return Astro.redirect('/admin?tab=users');

    } else if (action === 'delete_organization') {
      const orgId = formData.get('organizationId') as string;
      const { organizationRepository } = await import('../../lib/repositories/organizationRepository');
      await organizationRepository.softDelete(orgId);

      successMsg = 'Organización y sus actividades asociadas eliminadas correctamente.';
      return Astro.redirect('/admin?tab=orgs');
    }
  } catch (err: any) {
    errorMsg = err.message || 'Error al procesar la solicitud.';
  }
}
---

<Layout title="Panel Administrador | Kindora">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-zinc-100 pb-6">
      <div>
        <h1 class="text-3xl font-black tracking-tight text-zinc-950 flex items-center gap-2.5">
          <ShieldCheck class="h-8 w-8 text-purple-600" />
          Panel Administrador
        </h1>
        <p class="text-sm text-zinc-500 mt-1">Monitoreá la plataforma, verificá organizaciones y gestioná usuarios y contenidos en tiempo real.</p>
      </div>
      <div class="flex items-center gap-2 self-start md:self-auto">
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-xl">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Conectado como Superadmin
        </span>
      </div>
    </div>

    {successMsg && (
      <div class="rounded-2xl bg-emerald-50 border border-emerald-200 p-4 text-sm text-emerald-800 font-semibold shadow-sm flex items-center gap-2">
        <CheckCircle2 class="h-5 w-5 text-emerald-600 flex-shrink-0" />
        {successMsg}
      </div>
    )}
    {errorMsg && (
      <div class="rounded-2xl bg-rose-50 border border-rose-200 p-4 text-sm text-rose-700 font-semibold shadow-sm flex items-center gap-2">
        <XCircle class="h-5 w-5 text-rose-600 flex-shrink-0" />
        {errorMsg}
      </div>
    )}

    <!-- Interactive Stat Cards (Click to Inspect) -->
    <div>
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-xs font-bold text-zinc-400 uppercase tracking-wider">Métricas de Plataforma & Analítica</h2>
        <span class="text-xs text-purple-600 font-medium hidden sm:inline">Hacé click en cualquier tarjeta para inspeccionar</span>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 0. Card Analítica -->
        <button 
          type="button" 
          id="btn-tab-analytics"
          class="tab-trigger w-full text-left rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-purple-300 transition-all cursor-pointer group relative overflow-hidden"
          data-target="analytics"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                <BarChart3 class="h-5 w-5" />
              </span>
              <div>
                <span class="text-xs font-bold text-zinc-400 uppercase tracking-wider block">Conversión</span>
                <span class="text-2xl font-black text-zinc-950 block">{analyticsMetrics.conversionRate}%</span>
              </div>
            </div>
            <ArrowUpRight class="h-4 w-4 text-zinc-300 group-hover:text-indigo-600 transition-colors" />
          </div>
          <div class="mt-3 pt-2.5 border-t border-zinc-100 flex items-center justify-between text-[11px] text-indigo-700 font-semibold">
            <span>{analyticsMetrics.totalJoins} registros / {analyticsMetrics.totalViews} vistas</span>
            <span class="bg-indigo-50 px-1.5 py-0.5 rounded">Detalles &rarr;</span>
          </div>
        </button>

        <!-- 1. Card Usuarios -->
        <button 
          type="button" 
          id="btn-tab-users"
          class="tab-trigger w-full text-left rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-purple-300 transition-all cursor-pointer group relative overflow-hidden"
          data-target="users"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-purple-50 text-purple-600 group-hover:bg-purple-600 group-hover:text-white transition-colors">
                <Users class="h-5 w-5" />
              </span>
              <div>
                <span class="text-xs font-bold text-zinc-400 uppercase tracking-wider block">Usuarios</span>
                <span class="text-2xl font-black text-zinc-950 block">{stats.usersCount}</span>
              </div>
            </div>
            <ArrowUpRight class="h-4 w-4 text-zinc-300 group-hover:text-purple-600 transition-colors" />
          </div>
          <div class="mt-3 pt-2.5 border-t border-zinc-100 flex items-center justify-between text-[11px] text-purple-700 font-semibold">
            <span>DAU: {analyticsMetrics.dau} | WAU: {analyticsMetrics.wau}</span>
            <span class="bg-purple-50 px-1.5 py-0.5 rounded">Ver listado &rarr;</span>
          </div>
        </button>

        <!-- 2. Card Organizaciones -->
        <button 
          type="button" 
          id="btn-tab-orgs"
          class="tab-trigger w-full text-left rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-emerald-300 transition-all cursor-pointer group relative overflow-hidden"
          data-target="orgs"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                <Building2 class="h-6 w-6" />
              </span>
              <div>
                <span class="text-xs font-bold text-zinc-400 uppercase tracking-wider block">Organizaciones</span>
                <span class="text-3xl font-black text-zinc-950 block">{stats.orgsCount}</span>
              </div>
            </div>
            <ArrowUpRight class="h-5 w-5 text-zinc-300 group-hover:text-emerald-600 transition-colors" />
          </div>
          <div class="mt-4 pt-3 border-t border-zinc-100 flex items-center justify-between text-xs text-emerald-700 font-semibold">
            <span>Inspeccionar entidades</span>
            <span class="text-[10px] bg-emerald-50 px-2 py-0.5 rounded-md">Ver listado &rarr;</span>
          </div>
        </button>

        <!-- 3. Card Actividades -->
        <button 
          type="button" 
          id="btn-tab-activities"
          class="tab-trigger w-full text-left rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-blue-300 transition-all cursor-pointer group relative overflow-hidden"
          data-target="activities"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                <Calendar class="h-6 w-6" />
              </span>
              <div>
                <span class="text-xs font-bold text-zinc-400 uppercase tracking-wider block">Actividades Creadas</span>
                <span class="text-3xl font-black text-zinc-950 block">{stats.actsCount}</span>
              </div>
            </div>
            <ArrowUpRight class="h-5 w-5 text-zinc-300 group-hover:text-blue-600 transition-colors" />
          </div>
          <div class="mt-4 pt-3 border-t border-zinc-100 flex items-center justify-between text-xs text-blue-700 font-semibold">
            <span>Inspeccionar publicaciones</span>
            <span class="text-[10px] bg-blue-50 px-2 py-0.5 rounded-md">Ver listado &rarr;</span>
          </div>
        </button>
      </div>
    </div>

    <!-- Navigation Tabs Bar -->
    <div class="border-b border-zinc-200 flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
      <button 
        type="button" 
        data-target="users"
        class="tab-btn px-4 py-2.5 text-sm font-bold border-b-2 transition-all flex items-center gap-2 cursor-pointer border-transparent text-zinc-500 hover:text-zinc-900"
      >
        <Users class="h-4 w-4" />
        Usuarios ({allUsersList.length})
      </button>
      <button 
        type="button" 
        data-target="orgs"
        class="tab-btn px-4 py-2.5 text-sm font-bold border-b-2 transition-all flex items-center gap-2 cursor-pointer border-transparent text-zinc-500 hover:text-zinc-900"
      >
        <Building2 class="h-4 w-4" />
        Organizaciones ({allOrgsList.length})
      </button>
      <button 
        type="button" 
        data-target="activities"
        class="tab-btn px-4 py-2.5 text-sm font-bold border-b-2 transition-all flex items-center gap-2 cursor-pointer border-transparent text-zinc-500 hover:text-zinc-900"
      >
        <Calendar class="h-4 w-4" />
        Actividades ({allActivitiesList.length})
      </button>
      <button 
        type="button" 
        data-target="verifications"
        class="tab-btn px-4 py-2.5 text-sm font-bold border-b-2 transition-all flex items-center gap-2 cursor-pointer border-transparent text-zinc-500 hover:text-zinc-900"
      >
        <ShieldCheck class="h-4 w-4" />
        Solicitudes de Verificación ({pendingVerificationsList.length})
      </button>
    </div>

    <!-- TAB 1: LISTADO DE USUARIOS -->
    <div id="panel-users" class="tab-panel space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-zinc-950 flex items-center gap-2">
          <Users class="h-5 w-5 text-purple-600" />
          Listado Completo de Usuarios Registrados
        </h2>
        <span class="text-xs text-zinc-400 font-medium">Total: {allUsersList.length} usuarios</span>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-zinc-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-zinc-50 text-xs font-bold text-zinc-400 uppercase tracking-wider border-b border-zinc-100">
            <tr>
              <th class="px-6 py-4">Usuario</th>
              <th class="px-6 py-4">Email</th>
              <th class="px-6 py-4">Rol</th>
              <th class="px-6 py-4">Teléfono</th>
              <th class="px-6 py-4">Fecha Registro</th>
              <th class="px-6 py-4 text-right">Cambiar Rol</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 font-medium text-zinc-700">
            {allUsersList.map((u) => (
              <tr class="hover:bg-zinc-50/50 transition-colors">
                <td class="px-6 py-4 flex items-center gap-3">
                  <div class="flex h-9 w-9 items-center justify-center rounded-full bg-purple-100 text-purple-700 font-bold text-xs flex-shrink-0">
                    {u.name ? u.name.substring(0, 2).toUpperCase() : 'US'}
                  </div>
                  <div>
                    <span class="block font-bold text-zinc-900">{u.name}</span>
                    <span class="block text-[11px] text-zinc-400 font-mono">ID: {u.id}</span>
                  </div>
                </td>
                <td class="px-6 py-4 font-mono text-xs text-zinc-600">{u.email}</td>
                <td class="px-6 py-4">
                  {u.role === 'admin' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-purple-100 px-2.5 py-1 text-xs font-bold text-purple-800">
                      <Shield class="h-3.5 w-3.5" />
                      ADMIN
                    </span>
                  )}
                  {u.role === 'organizer' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-800">
                      <Building2 class="h-3.5 w-3.5" />
                      ORGANIZADOR
                    </span>
                  )}
                  {u.role === 'participant' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-zinc-100 px-2.5 py-1 text-xs font-bold text-zinc-600">
                      <Users class="h-3.5 w-3.5" />
                      PARTICIPANTE
                    </span>
                  )}
                </td>
                <td class="px-6 py-4 text-xs text-zinc-500">{u.phone || 'No registrado'}</td>
                <td class="px-6 py-4 text-xs text-zinc-500">{u.createdAt ? new Date(u.createdAt).toLocaleDateString('es-AR') : 'Reciente'}</td>
                <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                  <form method="POST" class="m-0 inline-flex items-center gap-1">
                    <input type="hidden" name="action" value="update_user_role" />
                    <input type="hidden" name="userId" value={u.id} />
                    <select name="role" class="rounded-xl border border-zinc-200 bg-white px-2 py-1 text-xs font-semibold focus:outline-none shadow-sm">
                      <option value="participant" selected={u.role === 'participant'}>Participante</option>
                      <option value="organizer" selected={u.role === 'organizer'}>Organizador</option>
                      <option value="admin" selected={u.role === 'admin'}>Admin</option>
                    </select>
                    <button type="submit" class="rounded-xl bg-zinc-900 hover:bg-zinc-800 px-2.5 py-1 text-xs font-bold text-white shadow-sm transition-all">
                      Guardar
                    </button>
                  </form>

                  {u.id !== currentUser.id && (
                    <form method="POST" class="m-0 inline-flex" onsubmit="return confirm('¿Seguro que deseas eliminar este usuario?');">
                      <input type="hidden" name="action" value="delete_user" />
                      <input type="hidden" name="userId" value={u.id} />
                      <button type="submit" class="rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 p-1.5 text-xs font-bold text-rose-700 transition-all" title="Eliminar usuario">
                        <Trash2 class="h-3.5 w-3.5" />
                      </button>
                    </form>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- TAB 2: LISTADO DE ORGANIZACIONES -->
    <div id="panel-orgs" class="tab-panel space-y-4 hidden">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-zinc-950 flex items-center gap-2">
          <Building2 class="h-5 w-5 text-emerald-600" />
          Listado Completo de Organizaciones Registradas
        </h2>
        <span class="text-xs text-zinc-400 font-medium">Total: {allOrgsList.length} organizaciones</span>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-zinc-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-zinc-50 text-xs font-bold text-zinc-400 uppercase tracking-wider border-b border-zinc-100">
            <tr>
              <th class="px-6 py-4">Organización</th>
              <th class="px-6 py-4">Tipo</th>
              <th class="px-6 py-4">Contacto</th>
              <th class="px-6 py-4">Nivel Verificación</th>
              <th class="px-6 py-4 text-right">Ver Pública</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 font-medium text-zinc-700">
            {allOrgsList.map((o) => (
              <tr class="hover:bg-zinc-50/50 transition-colors">
                <td class="px-6 py-4 flex items-center gap-3">
                  <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 font-bold text-sm flex-shrink-0">
                    {o.name ? o.name.substring(0, 2).toUpperCase() : 'OG'}
                  </div>
                  <div>
                    <span class="block font-bold text-zinc-900">{o.name}</span>
                    <span class="block text-[11px] text-zinc-400">/{o.slug}</span>
                  </div>
                </td>
                <td class="px-6 py-4 text-xs font-semibold text-zinc-600">{o.type || 'ONG'}</td>
                <td class="px-6 py-4 text-xs text-zinc-500">
                  <span class="block font-semibold text-zinc-800">{o.contactPerson || o.email}</span>
                  {o.phone && <span class="block text-[11px] text-zinc-400">{o.phone}</span>}
                </td>
                <td class="px-6 py-4">
                  {o.verificationLevel === 'official' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-blue-100 px-2.5 py-1 text-xs font-bold text-blue-800">
                      <CheckCircle2 class="h-3.5 w-3.5" /> Official
                    </span>
                  )}
                  {o.verificationLevel === 'foundation' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-purple-100 px-2.5 py-1 text-xs font-bold text-purple-800">
                      <CheckCircle2 class="h-3.5 w-3.5" /> Foundation
                    </span>
                  )}
                  {o.verificationLevel === 'verified' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-800">
                      <CheckCircle2 class="h-3.5 w-3.5" /> Verified
                    </span>
                  )}
                  {o.verificationLevel === 'none' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700 border border-amber-200">
                      Sin verificar
                    </span>
                  )}
                </td>
                <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                  <a 
                    href={`/organizacion/${o.slug}`} 
                    target="_blank" 
                    class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-50 px-3 py-1.5 text-xs font-bold text-zinc-700 transition-all shadow-sm"
                  >
                    Ver Ficha
                    <ExternalLink class="h-3.5 w-3.5 text-zinc-400" />
                  </a>

                  <form method="POST" class="m-0 inline-flex" onsubmit="return confirm('¿Seguro que deseas eliminar esta organización?');">
                    <input type="hidden" name="action" value="delete_organization" />
                    <input type="hidden" name="organizationId" value={o.id} />
                    <button type="submit" class="rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 p-1.5 text-xs font-bold text-rose-700 transition-all" title="Eliminar organización">
                      <Trash2 class="h-3.5 w-3.5" />
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- TAB 3: LISTADO DE ACTIVIDADES -->
    <div id="panel-activities" class="tab-panel space-y-4 hidden">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-zinc-950 flex items-center gap-2">
          <Calendar class="h-5 w-5 text-blue-600" />
          Listado Completo de Actividades Creadas
        </h2>
        <span class="text-xs text-zinc-400 font-medium">Total: {allActivitiesList.length} actividades</span>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-zinc-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-zinc-50 text-xs font-bold text-zinc-400 uppercase tracking-wider border-b border-zinc-100">
            <tr>
              <th class="px-6 py-4">Actividad</th>
              <th class="px-6 py-4">Organización</th>
              <th class="px-6 py-4">Categoría</th>
              <th class="px-6 py-4">Estado</th>
              <th class="px-6 py-4">Fecha Evento</th>
              <th class="px-6 py-4 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 font-medium text-zinc-700">
            {allActivitiesList.map((a) => (
              <tr class="hover:bg-zinc-50/50 transition-colors">
                <td class="px-6 py-4 font-bold text-zinc-900 max-w-xs truncate">
                  {a.title}
                </td>
                <td class="px-6 py-4 text-xs font-semibold text-zinc-600">
                  {a.orgName || 'Organización Kindora'}
                </td>
                <td class="px-6 py-4 text-xs font-medium text-zinc-500">
                  {a.categoryName || 'General'}
                </td>
                <td class="px-6 py-4">
                  {a.status === 'published' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-800">
                      Publicada
                    </span>
                  )}
                  {a.status === 'pending_review' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-amber-100 px-2.5 py-1 text-xs font-bold text-amber-800">
                      Pendiente Moderación
                    </span>
                  )}
                  {a.status === 'draft' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-zinc-100 px-2.5 py-1 text-xs font-bold text-zinc-600">
                      Borrador
                    </span>
                  )}
                  {a.status === 'completed' && (
                    <span class="inline-flex items-center gap-1 rounded-lg bg-blue-100 px-2.5 py-1 text-xs font-bold text-blue-800">
                      Finalizada
                    </span>
                  )}
                </td>
                <td class="px-6 py-4 text-xs text-zinc-500">
                  {a.startsAt ? new Date(a.startsAt).toLocaleDateString('es-AR') : 'Próxima'}
                </td>
                <td class="px-6 py-4 text-right flex items-center justify-end gap-2">
                  <a 
                    href={`/actividad/${a.slug}`} 
                    target="_blank" 
                    class="inline-flex items-center gap-1 rounded-xl border border-zinc-200 bg-white hover:bg-zinc-50 px-2.5 py-1.5 text-xs font-bold text-zinc-700 transition-all shadow-sm"
                  >
                    <Eye class="h-3.5 w-3.5 text-zinc-400" />
                    Ver
                  </a>

                  <!-- Delete Action -->
                  <form method="POST" class="m-0" onsubmit="return confirm('¿Seguro que deseas eliminar esta actividad?');">
                    <input type="hidden" name="action" value="delete_activity" />
                    <input type="hidden" name="activityId" value={a.id} />
                    <button type="submit" class="inline-flex items-center gap-1 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 px-2.5 py-1.5 text-xs font-bold text-rose-700 transition-all">
                      <Trash2 class="h-3.5 w-3.5" />
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- TAB 4: SOLICITUDES DE VERIFICACIÓN PENDIENTES -->
    <div id="panel-verifications" class="tab-panel space-y-4 hidden">
      <h2 class="text-xl font-bold text-zinc-950 flex items-center gap-2">
        <ShieldCheck class="h-5 w-5 text-purple-600" />
        Solicitudes de verificación pendientes ({pendingVerificationsList.length})
      </h2>

      {pendingVerificationsList.length === 0 ? (
        <p class="text-sm text-zinc-500 bg-zinc-50/50 rounded-xl p-5 border border-dashed border-zinc-200">No hay solicitudes de verificación pendientes por el momento.</p>
      ) : (
        <div class="grid grid-cols-1 gap-6">
          {pendingVerificationsList.map((req) => (
            <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm space-y-4">
              <div class="flex items-center justify-between border-b border-zinc-100 pb-3 flex-wrap gap-2">
                <div>
                  <h3 class="text-base font-bold text-zinc-950 leading-tight">
                    <a href={`/organizacion/${req.orgSlug}`} target="_blank" class="hover:text-emerald-600 transition-colors">
                      {req.orgName}
                    </a>
                  </h3>
                  <p class="text-xs text-zinc-400 mt-0.5">Solicitado por: <strong>{req.userName}</strong> el {new Date(req.createdAt).toLocaleDateString('es-AR')}</p>
                </div>
                <div class="flex items-center gap-2">
                  <!-- Approve Form -->
                  <form method="POST" class="m-0 flex items-center gap-2">
                    <input type="hidden" name="action" value="approve" />
                    <input type="hidden" name="organizationId" value={req.organizationId} />
                    
                    <select name="level" class="rounded-xl border border-zinc-200 bg-zinc-50 px-2 py-1 text-xs font-semibold focus:outline-none">
                      <option value="verified">Verified (Común)</option>
                      <option value="foundation">Foundation (Fundación)</option>
                      <option value="official">Official (Oficial)</option>
                      <option value="municipality">Municipality (Municipio)</option>
                    </select>

                    <button type="submit" class="inline-flex items-center gap-1 rounded-xl bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 text-xs font-bold text-white shadow-sm transition-all">
                      <CheckCircle2 class="h-3.5 w-3.5" />
                      Aprobar
                    </button>
                  </form>

                  <!-- Reject Form -->
                  <form method="POST" class="m-0">
                    <input type="hidden" name="action" value="reject" />
                    <input type="hidden" name="organizationId" value={req.organizationId} />
                    <button type="submit" class="inline-flex items-center gap-1 rounded-xl border border-zinc-200 hover:bg-rose-50 hover:text-rose-700 px-3 py-1.5 text-xs font-bold text-zinc-600 transition-all">
                      <XCircle class="h-3.5 w-3.5" />
                      Rechazar
                    </button>
                  </form>
                </div>
              </div>

              <!-- Request details -->
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
                <div>
                  <span class="block font-bold text-zinc-400 uppercase tracking-wider">DNI Responsable</span>
                  <span class="block font-semibold text-zinc-800 mt-1">{req.details.dni || 'No provisto'}</span>
                </div>
                <div>
                  <span class="block font-bold text-zinc-400 uppercase tracking-wider">Teléfono de Validación</span>
                  <span class="block font-semibold text-zinc-800 mt-1">{req.details.phone || 'No provisto'}</span>
                </div>
                <div class="md:col-span-3">
                  <span class="block font-bold text-zinc-400 uppercase tracking-wider mb-1">Documentación / Notas presentadas</span>
                  <p class="text-zinc-600 leading-relaxed bg-zinc-50 border border-zinc-100 p-3 rounded-xl">{req.details.notes || 'Sin aclaraciones adicionales.'}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>

  </div>
</Layout>

<script is:inline define:vars={{ activeTabParam }}>
  document.addEventListener('DOMContentLoaded', () => {
    const tabTriggers = document.querySelectorAll('.tab-trigger, .tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    function switchTab(targetId) {
      tabPanels.forEach(panel => {
        if (panel.id === `panel-${targetId}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });

      // Update tab buttons active styles
      document.querySelectorAll('.tab-btn').forEach(btn => {
        if (btn.getAttribute('data-target') === targetId) {
          btn.classList.add('border-purple-600', 'text-purple-600');
          btn.classList.remove('border-transparent', 'text-zinc-500');
        } else {
          btn.classList.remove('border-purple-600', 'text-purple-600');
          btn.classList.add('border-transparent', 'text-zinc-500');
        }
      });

      // Update stat cards active style
      document.querySelectorAll('.tab-trigger').forEach(card => {
        if (card.getAttribute('data-target') === targetId) {
          card.classList.add('ring-2', 'ring-purple-600', 'ring-offset-2');
        } else {
          card.classList.remove('ring-2', 'ring-purple-600', 'ring-offset-2');
        }
      });
    }

    tabTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const target = trigger.getAttribute('data-target');
        switchTab(target);
        // Optionally update URL without reload
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('tab', target);
        window.history.pushState({}, '', newUrl);
      });
    });

    // Initial tab setup
    const initialTarget = activeTabParam || 'users';
    switchTab(initialTarget);
  });
</script>
