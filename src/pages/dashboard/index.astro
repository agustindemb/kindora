---
// /dashboard — secure role-based routing page
// Reads the fresh role from the DB (via middleware) and redirects accordingly.
// Nobody can "trick" this by changing a URL — the role comes from the DB.

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

if (user.role === 'admin') {
  return Astro.redirect('/admin');
} else if (user.role === 'organizer') {
  return Astro.redirect('/dashboard/organizador');
} else {
  return Astro.redirect('/dashboard/participante');
}
---
