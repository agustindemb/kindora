---
import Layout from '../../layouts/Layout.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { activityRepository } from '../../lib/repositories/activityRepository';
import { userRepository } from '../../lib/repositories/userRepository';
import { notificationService } from '../../services/notificationService';
import { Calendar, Heart, User, Bell, Settings, Star, AlertCircle, Award, Clock, ShieldCheck, Share2, Trash2, Building2 } from 'lucide-astro';

import { getUserAvatar, AVATAR_PRESETS } from '../../utils/avatar';

const currentUser = Astro.locals.user;

if (!currentUser) {
  return Astro.redirect('/login');
}

const userName = currentUser.name || 'Usuario';
const userEmail = currentUser.email || '';
const userImage = getUserAvatar(currentUser);

// Fetch participant data safely
let inscriptionsList: any[] = [];
let bookmarkedActivities: any[] = [];
let notificationsList: any[] = [];

try {
  const rawIns = await activityRepository.getUserInscriptions(currentUser.id);
  if (Array.isArray(rawIns)) {
    inscriptionsList = rawIns.filter(ins => ins && ins.activity);
  }
} catch(e) {
  console.warn("[Participante] Error fetching user inscriptions:", e);
}

try {
  const rawBookmarks = await activityRepository.getBookmarkedActivities(currentUser.id);
  if (Array.isArray(rawBookmarks)) {
    bookmarkedActivities = rawBookmarks.filter(Boolean);
  }
} catch(e) {
  console.warn("[Participante] Error fetching bookmarked activities:", e);
}

try {
  const rawNotifs = await notificationService.getUserNotifications(currentUser.id);
  if (Array.isArray(rawNotifs)) {
    notificationsList = rawNotifs.filter(Boolean);
  }
} catch(e) {
  console.warn("[Participante] Error fetching user notifications:", e);
}

// Split registered activities
const now = new Date();
const upcomingInscriptions = (inscriptionsList || []).filter((ins) => 
  ins?.activity?.startsAt && 
  new Date(ins.activity.startsAt) > now && 
  ['registered', 'volunteer', 'volunteer_pending', 'volunteer_approved'].includes(ins.status)
);
const pastInscriptions = (inscriptionsList || []).filter((ins) => 
  ins?.activity?.startsAt && 
  (new Date(ins.activity.startsAt) <= now || ins.status === 'attended')
);

// Volunteer Impact Profile Metrics
const totalHours = (inscriptionsList || []).length * 2;
const causesSupported = Array.from(new Set((inscriptionsList || []).map(ins => ins?.activity?.category?.name).filter(Boolean)));

// Handle Profile Updates POST
let successMsg = '';
let errorMsg = '';
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action');

    if (action === 'update_profile') {
      const name = formData.get('name') as string;
      const phone = formData.get('phone') as string;
      const image = formData.get('image') as string;
      
      await userRepository.update(currentUser.id, {
        name,
        phone,
        image,
      });

      currentUser.name = name;
      currentUser.phone = phone;
      currentUser.image = image;
      successMsg = '¡Tu perfil y avatar se actualizaron correctamente!';
    } else if (action === 'switch_to_organizer') {
      await userRepository.update(currentUser.id, { role: 'organizer' });
      currentUser.role = 'organizer';
      return Astro.redirect('/dashboard/organizador');
    } else if (action === 'delete_account') {
      await userRepository.hardDelete(currentUser.id);
      const { auth } = await import('../../lib/auth/auth');
      try {
        await auth.api.signOut({ headers: Astro.request.headers });
      } catch(e){}
      return Astro.redirect('/login?deleted=true');
    }
  } catch (err: any) {
    errorMsg = err.message || 'Error al guardar los datos.';
  }
}
---

<Layout title="Mi Cuenta & Impacto | Kindora">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    
    <!-- User Header Banner -->
    <div class="rounded-3xl border border-zinc-100 bg-gradient-to-br from-emerald-900 via-zinc-900 to-zinc-950 p-6 md:p-8 text-white flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 relative overflow-hidden shadow-xl">
      <div class="absolute inset-0 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:20px_20px] opacity-15"></div>
      
      <div class="relative flex items-center gap-4">
        <img 
          src={userImage} 
          alt={userName} 
          class="h-16 w-16 md:h-20 md:w-20 rounded-full object-cover border-2 border-emerald-400/50 shadow-md"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=100';"
        />
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="inline-flex rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider">
              Voluntario Activo
            </span>
            <ShieldCheck class="h-4 w-4 text-emerald-400" title="Perfil Verificado" />
          </div>
          <h1 class="text-2xl md:text-3xl font-black tracking-tight leading-none mb-1 text-white">{userName}</h1>
          <p class="text-xs text-zinc-400">{userEmail}</p>
        </div>
      </div>

      <!-- Impact Profile Badges -->
      <div class="relative flex flex-wrap items-center gap-3 text-xs font-semibold">
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-3.5 text-center min-w-[100px]">
          <span class="flex items-center justify-center gap-1 text-xl font-black text-emerald-400 leading-none mb-1">
            <Clock class="h-4 w-4 text-emerald-400" />
            {totalHours}h
          </span>
          <span class="text-[11px] text-zinc-300">Horas Donadas</span>
        </div>
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-3.5 text-center min-w-[100px]">
          <span class="flex items-center justify-center gap-1 text-xl font-black text-white leading-none mb-1">
            <Award class="h-4 w-4 text-amber-400" />
            {inscriptionsList.length}
          </span>
          <span class="text-[11px] text-zinc-300">Actividades</span>
        </div>
        <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-3.5 text-center min-w-[100px]">
          <span class="flex items-center justify-center gap-1 text-xl font-black text-white leading-none mb-1">
            <Heart class="h-4 w-4 text-rose-400" />
            {bookmarkedActivities.length}
          </span>
          <span class="text-[11px] text-zinc-300">Guardadas</span>
        </div>
      </div>
    </div>

    <!-- Navigation Tabs / Sections -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-4">
      
      <!-- Sidebar Tabs selector -->
      <aside class="lg:col-span-1 border border-zinc-100 rounded-2xl p-4 bg-zinc-50/30 self-start">
        <nav class="flex flex-col gap-1.5" id="dashboard-tabs">
          <button 
            type="button" 
            class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-semibold rounded-xl text-left bg-emerald-50 text-emerald-700 transition-all"
            data-tab="mis-actividades"
          >
            <Calendar class="h-4.5 w-4.5" />
            Mis Actividades
          </button>
          <button 
            type="button" 
            class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-semibold rounded-xl text-left text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 transition-all"
            data-tab="favoritos"
          >
            <Heart class="h-4.5 w-4.5" />
            Favoritos
          </button>
          <button 
            type="button" 
            class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-semibold rounded-xl text-left text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 transition-all"
            data-tab="perfil"
          >
            <User class="h-4.5 w-4.5" />
            Mi Perfil
          </button>
          <button 
            type="button" 
            class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-semibold rounded-xl text-left text-zinc-600 hover:text-zinc-900 hover:bg-zinc-50 transition-all justify-between"
            data-tab="notificaciones"
          >
            <span class="flex items-center gap-2.5">
              <Bell class="h-4.5 w-4.5" />
              Notificaciones
            </span>
            {notificationsList.filter(n => !n.readAt).length > 0 && (
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-600 text-[10px] font-bold text-white leading-none">
                {notificationsList.filter(n => !n.readAt).length}
              </span>
            )}
          </button>
        </nav>
      </aside>

      <!-- Content Display Panel -->
      <div class="lg:col-span-3 space-y-6">
        
        <!-- Action feedback alerts -->
        {successMsg && (
          <div class="rounded-xl bg-emerald-50 border border-emerald-100 p-4 text-sm text-emerald-800 font-semibold shadow-sm">
            {successMsg}
          </div>
        )}
        {errorMsg && (
          <div class="rounded-xl bg-rose-50 border border-rose-100 p-4 text-sm text-rose-700 font-semibold shadow-sm">
            {errorMsg}
          </div>
        )}

        <!-- Tab 1: Mis Actividades -->
        <section id="tab-content-mis-actividades" class="space-y-8 block">
          
          <!-- Upcoming Activities -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-zinc-950">Próximas actividades</h2>
            {upcomingInscriptions.length === 0 ? (
              <EmptyState 
                icon="calendar"
                title="No tenés actividades agendadas"
                description="Explorá la plataforma para encontrar tu próximo voluntariado, taller o deporte inclusivo."
                actionText="Explorar actividades"
                actionHref="/explorar"
              />
            ) : (
              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                {upcomingInscriptions.map((ins) => (
                  <div class="flex flex-col">
                    {ins.status === 'volunteer_pending' && (
                      <div class="mb-2.5 inline-flex items-center gap-1.5 rounded-xl bg-amber-50 border border-amber-200 px-3 py-1.5 text-xs font-bold text-amber-800 w-fit">
                        <span>⏳</span>
                        <span>Postulación de voluntariado en revisión</span>
                      </div>
                    )}
                    {(ins.status === 'volunteer_approved' || ins.status === 'volunteer') && (
                      <div class="mb-2.5 inline-flex items-center gap-1.5 rounded-xl bg-violet-50 border border-violet-200 px-3 py-1.5 text-xs font-bold text-violet-700 w-fit">
                        <span>🌱</span>
                        <span>Voluntariado Aprobado</span>
                      </div>
                    )}
                    <ActivityCard activity={ins.activity} />
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Past Activities / History -->
          <div class="space-y-4 pt-6 border-t border-zinc-100">
            <h2 class="text-xl font-bold text-zinc-950">Historial y asistencia</h2>
            {pastInscriptions.length === 0 ? (
              <EmptyState 
                icon="sparkles"
                title="Aún no participaste de actividades"
                description="Una vez que asistas a actividades completadas, podrás ver aquí tu historial y dejar tus reseñas."
              />
            ) : (
              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                {pastInscriptions.map((ins) => (
                  <div>
                    <ActivityCard activity={ins.activity} />
                    <div class="mt-3">
                      <a 
                        href={`/actividad/${ins.activity.id}-${ins.activity.slug}#opiniones`} 
                        class="w-full inline-flex items-center justify-center gap-1 text-xs font-bold border border-zinc-200 bg-white hover:bg-zinc-50 px-3 py-2 rounded-xl text-zinc-700 transition-all"
                      >
                        <Star class="h-3.5 w-3.5 text-amber-400 fill-amber-400" />
                        Dejar reseña
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

        </section>

        <!-- Tab 2: Favoritos -->
        <section id="tab-content-favoritos" class="space-y-4 hidden">
          <h2 class="text-xl font-bold text-zinc-950">Actividades guardadas</h2>
          {bookmarkedActivities.length === 0 ? (
            <EmptyState 
              icon="heart"
              title="Todavía no guardaste actividades"
              description="Hacé click en el corazón de cualquier tarjeta de actividad para guardarla en tus favoritos y acceder rápidamente."
              actionText="Explorar actividades"
              actionHref="/explorar"
            />
          ) : (
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              {bookmarkedActivities.map((act) => (
                <ActivityCard activity={act} isBookmarked={true} />
              ))}
            </div>
          )}
        </section>

        <!-- Tab 3: Mi Perfil -->
        <section id="tab-content-perfil" class="space-y-6 hidden">
          <div class="space-y-1">
            <h2 class="text-xl font-bold text-zinc-950 font-sans">Mi Perfil</h2>
            <p class="text-xs text-zinc-500">Mantené tus datos de contacto al día para recibir recordatorios.</p>
          </div>
          
          <form method="POST" class="space-y-4 max-w-lg">
            <input type="hidden" name="action" value="update_profile" />
            
            <div>
              <label for="profile-name" class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">Nombre completo</label>
              <input 
                type="text" 
                id="profile-name"
                name="name" 
                value={currentUser.name}
                class="w-full rounded-xl border border-zinc-200 bg-white p-3 text-sm focus:outline-none focus:border-emerald-600 font-medium"
                required
              />
            </div>

            <div>
              <label for="profile-phone" class="block text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">Teléfono / Celular</label>
              <input 
                type="tel" 
                id="profile-phone"
                name="phone" 
                value={currentUser.phone || ''}
                placeholder="ej: +54 9 11 5555-5555"
                class="w-full rounded-xl border border-zinc-200 bg-white p-3 text-sm focus:outline-none focus:border-emerald-600 font-medium"
              />
              <p class="text-[10px] text-zinc-400 mt-1">Vinculá tu número celular para habilitar notificaciones por WhatsApp en el futuro.</p>
            </div>

            <!-- Avatar Selection Section -->
            <div class="space-y-3 pt-2">
              <label class="block text-xs font-bold text-zinc-400 uppercase tracking-wider">Elegí tu Avatar o Foto de Perfil</label>
              
              <!-- Hidden Image Input -->
              <input type="hidden" id="profile-image" name="image" value={currentUser.image || userImage} />

              <!-- Live Selected Avatar Preview -->
              <div class="flex items-center gap-4 bg-zinc-50 border border-zinc-200/80 rounded-2xl p-4">
                <img 
                  id="avatar-live-preview" 
                  src={userImage} 
                  alt="Avatar Seleccionado" 
                  class="h-16 w-16 rounded-full object-cover border-2 border-emerald-500 shadow-sm" 
                />
                <div>
                  <h4 class="text-sm font-bold text-zinc-900">Avatar Actual</h4>
                  <p class="text-xs text-zinc-500">Seleccioná una carita animada o pegá el link de tu propia foto.</p>
                </div>
              </div>

              <!-- Animated Faces Grid -->
              <div class="space-y-2">
                <p class="text-xs font-bold text-zinc-700">Caritas Animadas Ilustradas:</p>
                <div class="grid grid-cols-4 sm:grid-cols-6 gap-2 bg-white border border-zinc-200 rounded-2xl p-3 max-h-48 overflow-y-auto">
                  {AVATAR_PRESETS.map((preset) => (
                    <button
                      type="button"
                      class="avatar-preset-btn flex items-center justify-center rounded-xl p-1.5 border border-zinc-100 hover:border-emerald-500 hover:bg-emerald-50/50 transition-all cursor-pointer group"
                      data-url={preset.url}
                      title={preset.name}
                    >
                      <img src={preset.url} alt={preset.name} class="h-10 w-10 rounded-full object-cover group-hover:scale-105 transition-transform" />
                    </button>
                  ))}
                </div>
              </div>

              <!-- Custom Photo URL Input -->
              <div>
                <label for="custom-avatar-url" class="block text-xs font-bold text-zinc-600 mb-1">O pegá el link de tu propia foto (Google, Imgur, Instagram):</label>
                <input 
                  type="url" 
                  id="custom-avatar-url" 
                  placeholder="https://..." 
                  value={currentUser.image || ''}
                  class="w-full rounded-xl border border-zinc-200 bg-white p-3 text-xs focus:outline-none focus:border-emerald-600 font-medium" 
                />
              </div>
            </div>

            <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-emerald-700 transition-all">
              Guardar cambios
            </button>
          </form>

          <!-- Account Type Switcher -->
          <div class="pt-6 border-t border-zinc-100 max-w-lg">
            <h3 class="text-xs font-bold text-zinc-400 uppercase tracking-wider mb-2">¿Querés publicar actividades?</h3>
            <p class="text-xs text-zinc-500 mb-3 leading-relaxed">Si representás a una ONG, fundación o grupo comunitario, podés convertir tu cuenta en Organización para publicar actividades e inscriptos.</p>
            <form method="POST" class="m-0">
              <input type="hidden" name="action" value="switch_to_organizer" />
              <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition-all cursor-pointer">
                <Building2 class="h-4 w-4 text-emerald-400" />
                Convertir mi cuenta a Organización &rarr;
              </button>
            </form>
          </div>

          <!-- Danger Zone: Delete Account -->
          <div class="pt-6 border-t border-rose-100 max-w-lg">
            <h3 class="text-xs font-bold text-rose-500 uppercase tracking-wider mb-2">Zona de Peligro</h3>
            <p class="text-xs text-zinc-500 mb-3 leading-relaxed">Si eliminás tu cuenta, se borrará tu perfil y tus inscripciones de la plataforma. Esta acción no se puede deshacer.</p>
            <form method="POST" class="m-0" onclick="return confirm('¿Estás seguro de que querés eliminar tu cuenta de Kindora? Esta acción no se puede deshacer.');">
              <input type="hidden" name="action" value="delete_account" />
              <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 border border-rose-200 px-4 py-2.5 text-xs font-bold text-rose-700 transition-all cursor-pointer">
                <Trash2 class="h-4 w-4 text-rose-600" />
                Eliminar mi cuenta
              </button>
            </form>
          </div>
        </section>

        <!-- Tab 4: Notificaciones -->
        <section id="tab-content-notificaciones" class="space-y-4 hidden">
          <h2 class="text-xl font-bold text-zinc-950">Notificaciones recibidas</h2>
          {notificationsList.length === 0 ? (
            <p class="text-sm text-zinc-500 bg-zinc-50/50 rounded-xl p-5 border border-dashed border-zinc-200">No tenés notificaciones pendientes.</p>
          ) : (
            <div class="space-y-3">
              {notificationsList.map((notif) => (
                <div class={`rounded-xl border p-4 flex gap-3 ${notif.readAt ? 'bg-white border-zinc-100 text-zinc-600' : 'bg-emerald-50/10 border-emerald-100 text-zinc-800 font-medium'}`}>
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white border border-zinc-100 flex-shrink-0">
                    <span class="text-lg">📢</span>
                  </div>
                  <div>
                    <h4 class="text-sm font-bold leading-tight">{notif.title}</h4>
                    <p class="text-xs text-zinc-500 mt-0.5">{notif.body}</p>
                    <time class="text-[10px] text-zinc-400 block mt-1.5">
                      {new Date(notif.createdAt).toLocaleDateString('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })} hs
                    </time>
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>

      </div>

    </div>
  </div>
</Layout>

<script>
  // Simple client-side tab switching
  const tabs = document.querySelectorAll('#dashboard-tabs button');
  const sections = document.querySelectorAll('section[id^="tab-content-"]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');
      
      // Update Tab button active styling
      tabs.forEach(t => {
        t.classList.remove('bg-emerald-50', 'text-emerald-700');
        t.classList.add('text-zinc-600', 'hover:bg-zinc-50');
      });
      tab.classList.remove('text-zinc-600', 'hover:bg-zinc-50');
      tab.classList.add('bg-emerald-50', 'text-emerald-700');

      // Update Section visibility
      sections.forEach(sec => {
        if (sec.id === `tab-content-${target}`) {
          sec.classList.remove('hidden');
          sec.classList.add('block');
        } else {
          sec.classList.remove('block');
          sec.classList.add('hidden');
        }
      });
    });
  });

  // Handle direct tab anchors in URL (e.g. #favoritos)
  window.addEventListener('load', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash) {
      const matchingTab = document.querySelector(`[data-tab="${hash}"]`);
      if (matchingTab) (matchingTab as HTMLElement).click();
    }
  });

  // Client-side Avatar Picker
  const profileImageInput = document.getElementById('profile-image') as HTMLInputElement;
  const avatarPreview = document.getElementById('avatar-live-preview') as HTMLImageElement;
  const customAvatarUrlInput = document.getElementById('custom-avatar-url') as HTMLInputElement;
  const presetBtns = document.querySelectorAll('.avatar-preset-btn');

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-url');
      if (url && profileImageInput && avatarPreview) {
        profileImageInput.value = url;
        avatarPreview.src = url;
        if (customAvatarUrlInput) customAvatarUrlInput.value = '';
      }
    });
  });

  if (customAvatarUrlInput) {
    customAvatarUrlInput.addEventListener('input', (e) => {
      const url = (e.target as HTMLInputElement).value;
      if (url && profileImageInput && avatarPreview) {
        profileImageInput.value = url;
        avatarPreview.src = url;
      }
    });
  }
</script>
