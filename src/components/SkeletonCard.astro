---
interface Props {
  count?: number;
}

const { count = 1 } = Astro.props;
const items = Array.from({ length: count });
---

{items.map(() => (
  <div class="flex flex-col overflow-hidden rounded-2xl border border-zinc-100 bg-white shadow-sm animate-pulse">
    <!-- Image Skeleton -->
    <div class="aspect-[4/3] w-full bg-zinc-200"></div>

    <!-- Content Skeleton -->
    <div class="flex flex-1 flex-col p-5 space-y-4">
      <div class="h-3 w-1/3 bg-zinc-200 rounded-md"></div>
      <div class="space-y-2">
        <div class="h-4 w-5/6 bg-zinc-200 rounded-md"></div>
        <div class="h-4 w-2/3 bg-zinc-200 rounded-md"></div>
      </div>
      <div class="pt-4 border-t border-zinc-50 flex items-center justify-between">
        <div class="h-3 w-1/2 bg-zinc-200 rounded-md"></div>
        <div class="h-5 w-5 bg-zinc-200 rounded"></div>
      </div>
    </div>
  </div>
))}
