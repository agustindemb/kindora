---
import { Heart, Search, Bell, User, LogOut, LayoutDashboard, PlusCircle, Building2 } from 'lucide-astro';

const user = Astro.locals.user;
const activePath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-100 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2" id="nav-brand">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-600 text-white font-bold text-lg shadow-sm shadow-emerald-200">K</span>
      <span class="text-xl font-bold tracking-tight text-zinc-900">Kindora</span>
    </a>

    <!-- Navigation links -->
    <nav class="hidden md:flex items-center gap-6">
      <a 
        href="/explorar" 
        class={`text-sm font-medium transition-colors hover:text-emerald-600 ${activePath.startsWith('/explorar') ? 'text-emerald-600' : 'text-zinc-600'}`}
        id="nav-link-explore"
      >
        Explorá Actividades
      </a>
      {user && user.role === 'organizer' && (
        <>
          <a 
            href="/dashboard/organizador" 
            class={`text-sm font-medium transition-colors hover:text-emerald-600 ${activePath.startsWith('/dashboard/organizador') ? 'text-emerald-600' : 'text-zinc-600'}`}
          >
            Mi Organización
          </a>
          <a 
            href="/dashboard/organizador/crear" 
            class="flex items-center gap-1 text-sm font-medium text-emerald-600 hover:text-emerald-700"
          >
            <PlusCircle class="h-4 w-4" />
            Creá una Actividad
          </a>
        </>
      )}
      {user && user.role === 'participant' && (
        <>
          <a 
            href="/dashboard/participante" 
            class={`text-sm font-medium transition-colors hover:text-emerald-600 ${activePath.startsWith('/dashboard/participante') ? 'text-emerald-600' : 'text-zinc-600'}`}
          >
            Mis Actividades
          </a>
          <a 
            href="/dashboard/participante#favoritos" 
            class="flex items-center gap-1 text-sm font-medium text-zinc-600 hover:text-emerald-600"
          >
            <Heart class="h-4 w-4" />
            Guardados
          </a>
        </>
      )}
      {user && user.role === 'admin' && (
        <a 
          href="/admin" 
          class="text-sm font-medium text-purple-600 hover:text-purple-700"
        >
          Panel Administrador
        </a>
      )}
    </nav>

    <!-- User Action buttons -->
    <div class="flex items-center gap-4">
      {user ? (
        <div class="flex items-center gap-3">
          <!-- Notification Bell -->
          <a href={user.role === 'organizer' ? '/dashboard/organizador#notificaciones' : '/dashboard/participante#notificaciones'} class="relative p-2 rounded-lg text-zinc-500 hover:bg-zinc-50 hover:text-zinc-900 transition-all" aria-label="Notificaciones">
            <Bell class="h-5 w-5" />
            <span class="absolute top-1 right-1 h-2.5 w-2.5 rounded-full bg-emerald-500 ring-2 ring-white"></span>
          </a>

          <!-- User Menu Dropdown (Interactive) -->
          <div class="relative group">
            <button 
              type="button" 
              class="flex items-center gap-2 p-1 rounded-full border border-zinc-200 hover:border-zinc-300 transition-all"
              id="user-menu-button"
              aria-expanded="false"
              aria-haspopup="true"
            >
              <img 
                src={user.image || `https://api.dicebear.com/7.x/adventurer/svg?seed=${user.name}`} 
                alt={user.name} 
                class="h-8 w-8 rounded-full object-cover"
              />
            </button>
            
            <!-- Dropdown menu -->
            <div class="absolute right-0 mt-2 w-56 origin-top-right rounded-xl border border-zinc-100 bg-white p-2 shadow-lg ring-1 ring-black/5 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 before:content-[''] before:absolute before:-top-2 before:left-0 before:right-0 before:h-2">
              <div class="px-3 py-2 border-b border-zinc-50">
                <p class="text-sm font-semibold text-zinc-900 leading-none mb-1">{user.name}</p>
                <p class="text-xs text-zinc-500 truncate leading-none">{user.email}</p>
              </div>
              <div class="py-1">
                {user.role === 'organizer' ? (
                  <a href="/dashboard/organizador" class="flex items-center gap-2 px-3 py-2 text-sm rounded-lg text-zinc-700 hover:bg-zinc-50 transition-colors">
                    <Building2 class="h-4 w-4 text-zinc-400" />
                    Mi Organización
                  </a>
                ) : (
                  <a href="/dashboard/participante" class="flex items-center gap-2 px-3 py-2 text-sm rounded-lg text-zinc-700 hover:bg-zinc-50 transition-colors">
                    <User class="h-4 w-4 text-zinc-400" />
                    Mi Perfil
                  </a>
                )}
                <a href={user.role === 'organizer' ? '/dashboard/organizador#configuracion' : '/dashboard/participante#perfil'} class="flex items-center gap-2 px-3 py-2 text-sm rounded-lg text-zinc-700 hover:bg-zinc-50 transition-colors">
                  Configuración
                </a>
              </div>
              <div class="border-t border-zinc-50 pt-1">
                <form action="/auth/logout" method="POST" class="m-0">
                  <button type="submit" class="flex w-full items-center gap-2 px-3 py-2 text-sm rounded-lg text-rose-600 hover:bg-rose-50 transition-colors text-left">
                    <LogOut class="h-4 w-4 text-rose-400" />
                    Cerrar sesión
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="flex items-center gap-3">
          <a href="/login" class="text-sm font-semibold text-zinc-700 hover:text-emerald-600 transition-colors">
            Iniciar sesión
          </a>
          <a 
            href="/login?role=organizer" 
            class="hidden sm:inline-flex items-center justify-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-emerald-100 hover:bg-emerald-700 transition-all hover:scale-[1.02] active:scale-[0.98]"
            id="nav-btn-org"
          >
            Sumar mi organización
          </a>
        </div>
      )}
    </div>
  </div>
</header>
