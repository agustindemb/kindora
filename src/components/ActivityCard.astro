---
import { Calendar, MapPin, CheckCircle2, Heart, Award } from 'lucide-astro';
import type { ActivityWithDetails } from '../lib/repositories/activityRepository';

interface Props {
  activity: ActivityWithDetails;
  isBookmarked?: boolean;
}

const { activity, isBookmarked = false } = Astro.props;

// Format Date
const startsDate = new Date(activity.startsAt);
const formattedDate = startsDate.toLocaleDateString('es-AR', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false
});

const isFree = parseFloat(activity.price) === 0;
const spotsLeft = Math.max(0, activity.capacity - activity.confirmedRegistrations);
const isSoldOut = spotsLeft === 0;

// Cover Image Fallback
const coverImage = activity.images?.find((img) => img.isCover)?.url 
  || activity.images?.[0]?.url 
  || "https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?q=80&w=800";

// Org Verification styles
const isOrgVerified = activity.organization?.verificationLevel !== 'none';
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-zinc-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-zinc-200 hover:shadow-md">
  
  <!-- Image Container -->
  <a href={`/actividad/${activity.id}-${activity.slug}`} class="relative block aspect-[4/3] w-full overflow-hidden bg-zinc-100" aria-label={`Ver detalles de ${activity.title}`}>
    <img 
      src={coverImage} 
      alt={activity.title}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?q=80&w=800';"
    />
    
    <!-- Top Overlay badges -->
    <div class="absolute inset-x-3 top-3 flex items-start justify-between gap-2">
      <!-- Category Badge -->
      <span class="inline-flex items-center rounded-lg bg-white/90 px-2.5 py-1 text-xs font-semibold text-zinc-900 shadow-sm backdrop-blur-sm">
        <span class="mr-1">{activity.category?.name === 'Autismo' ? '🧩' : activity.category?.name === 'Medio ambiente' ? '🌱' : activity.category?.name === 'Discapacidad' ? '♿' : '🤝'}</span>
        {activity.category?.name}
      </span>

      <!-- Bookmark Button (Visual Mock for MVP) -->
      <button 
        type="button" 
        class={`rounded-full p-2 shadow-sm transition-all hover:scale-115 ${isBookmarked ? 'bg-rose-50 text-rose-500' : 'bg-white/90 text-zinc-400 hover:text-rose-500'} backdrop-blur-sm`}
        aria-label={isBookmarked ? "Quitar de favoritos" : "Guardar actividad"}
      >
        <Heart class={`h-4 w-4 ${isBookmarked ? 'fill-rose-500' : ''}`} />
      </button>
    </div>

    <!-- Bottom Pricing Tag -->
    {isFree && (
      <div class="absolute bottom-3 left-3">
        <span class="inline-flex items-center rounded-lg bg-emerald-500 px-2.5 py-1 text-xs font-bold text-white shadow-sm">
          Gratis
        </span>
      </div>
    )}
  </a>

  <!-- Content Container -->
  <div class="flex flex-1 flex-col p-5">
    
    <!-- Organization name & verified badge -->
    <a href={`/organizacion/${activity.organization?.slug}`} class="flex items-center gap-1 text-xs font-medium text-zinc-500 hover:text-emerald-600 transition-colors mb-2">
      <span class="truncate">{activity.organization?.name}</span>
      {isOrgVerified && (
        <CheckCircle2 class="h-3.5 w-3.5 fill-emerald-500 text-white flex-shrink-0" title="Organización Verificada" />
      )}
    </a>

    <!-- Title -->
    <h3 class="text-base font-bold text-zinc-900 line-clamp-2 group-hover:text-emerald-700 transition-colors leading-snug mb-3">
      <a href={`/actividad/${activity.id}-${activity.slug}`}>
        {activity.title}
      </a>
    </h3>

    <!-- Date & Location Details -->
    <div class="mt-auto space-y-2">
      <div class="flex items-center gap-2 text-xs text-zinc-600">
        <Calendar class="h-4 w-4 text-zinc-400 flex-shrink-0" />
        <span class="capitalize">{formattedDate} hs</span>
      </div>

      <div class="flex items-center gap-2 text-xs text-zinc-600">
        <MapPin class="h-4 w-4 text-zinc-400 flex-shrink-0" />
        <span class="truncate">{activity.location?.city}, {activity.location?.province}</span>
      </div>

      <!-- Capacity indicators -->
      <div class="border-t border-zinc-50 pt-3 mt-3 flex items-center justify-between">
        {isSoldOut ? (
          <span class="inline-flex items-center text-xs font-medium text-rose-600">
            Cupos completos
          </span>
        ) : (
          <span class="inline-flex items-center text-xs text-zinc-500">
            <span class="font-bold text-zinc-700 mr-1">{spotsLeft}</span> lugares disponibles
          </span>
        )}
        
        <!-- Quick Indicators for A11y / TEA -->
        <div class="flex gap-1">
          {activity.accessibility?.slice(0, 2).map((feat) => (
            <span 
              class="inline-flex h-5 w-5 items-center justify-center rounded bg-zinc-50 text-[10px]" 
              title={feat.name}
            >
              {feat.name.includes("TEA") ? "🧩" : feat.name.includes("silla") ? "♿" : "🤝"}
            </span>
          ))}
        </div>
      </div>
    </div>

  </div>
</article>
