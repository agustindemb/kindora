---
import { Star } from 'lucide-astro';

interface Props {
  review: {
    id: string;
    rating: number;
    comment: string;
    createdAt: Date;
    user: {
      name: string;
      image?: string | null;
    };
  };
}

const { review } = Astro.props;

// Date formatter
const formattedDate = new Date(review.createdAt).toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<div class="flex flex-col gap-4 rounded-xl border border-zinc-100 bg-white p-5 shadow-sm">
  <!-- Header: Avatar, Name & Date -->
  <div class="flex items-center gap-3">
    <img 
      src={review.user.image || `https://api.dicebear.com/7.x/adventurer/svg?seed=${review.user.name}`} 
      alt={review.user.name} 
      class="h-10 w-10 rounded-full object-cover border border-zinc-100"
    />
    <div>
      <h4 class="text-sm font-bold text-zinc-950 leading-none mb-1">{review.user.name}</h4>
      <time class="text-xs text-zinc-400">{formattedDate}</time>
    </div>
    
    <!-- Stars -->
    <div class="ml-auto flex items-center gap-0.5">
      {Array.from({ length: 5 }).map((_, i) => (
        <Star 
          class={`h-4 w-4 ${i < review.rating ? 'fill-amber-400 text-amber-400' : 'text-zinc-200'}`} 
        />
      ))}
    </div>
  </div>

  <!-- Comment Body -->
  <p class="text-sm leading-relaxed text-zinc-700">
    {review.comment}
  </p>
</div>
