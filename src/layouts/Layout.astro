---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const {
  title = "Kindora | Actividades con impacto positivo",
  description = "Descubrí actividades para compartir, aprender y ayudar. Encontrá talleres, voluntariados, deportes inclusivos y experiencias que hacen bien.",
  image = "/images/og-kindora.jpg",
  showHeader = true,
  showFooter = true
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://kindora.com.ar');
const currentUser = Astro.locals.user;
const isLoggedIn = !!currentUser;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Outfit (Títulos) & Inter (Cuerpo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Leaflet Map CSS (For accessible, keyless maps) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- SEO Primary Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- A11y: Keyboard Focus Outline Utility Styles -->
    <style is:global>
      body {
        font-family: 'Inter', sans-serif;
        color: #18181b; /* zinc-900 */
        background-color: #ffffff;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', sans-serif;
      }
      /* Custom focus visible styles for better keyboard accessibility */
      *:focus-visible {
        outline: 2px solid #059669; /* emerald-600 */
        outline-offset: 2px;
      }
      /* Simple elegant scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #f4f4f5; /* zinc-100 */
      }
      ::-webkit-scrollbar-thumb {
        background: #d4d4d8; /* zinc-300 */
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #a1a1aa; /* zinc-400 */
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    {showHeader && <Header />}
    <main class="flex-grow">
      <slot />
    </main>
    {showFooter && <Footer />}

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    {isLoggedIn && (
      <div>
        {/* Idle Timeout Warning Modal */}
        <div id="idle-warning-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-zinc-950/60 backdrop-blur-sm hidden">
        <div class="w-full max-w-md bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-zinc-100 text-center space-y-5">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-100 text-amber-700 text-2xl font-bold shadow-inner">
            🔒
          </div>
          <div class="space-y-2">
            <h3 class="text-xl font-extrabold text-zinc-900 tracking-tight">Cierre de sesión por inactividad</h3>
            <p class="text-sm text-zinc-600 leading-relaxed">
              No hemos detectado actividad en tu cuenta recientemente. Por razones de seguridad, tu sesión se cerrará automáticamente en:
            </p>
            <div class="py-2">
              <span id="idle-countdown" class="inline-block text-3xl font-black text-amber-600 bg-amber-50 px-4 py-2 rounded-2xl border border-amber-200 font-mono">60</span>
              <span class="block text-xs font-semibold text-zinc-400 mt-1">segundos</span>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row gap-2.5 pt-2">
            <button
              type="button"
              id="idle-extend-btn"
              class="w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-600/20 transition-all cursor-pointer"
            >
              Mantener sesión activa
            </button>
            <a
              href="/auth/logout?reason=idle"
              class="w-full py-3 px-4 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-700 font-semibold text-sm transition-all cursor-pointer text-center"
            >
              Cerrar sesión ahora
            </a>
          </div>
        </div>
      </div>

        {/* Idle Auto-Logout Script */}
        <script>
          (function() {
            const IDLE_WARN_MS = 14 * 60 * 1000; // 14 minutes
            const IDLE_LOGOUT_MS = 15 * 60 * 1000; // 15 minutes
            const COUNTDOWN_SEC = 60;

            const storedLastStr = localStorage.getItem('kindora_last_activity');
            let lastActivity = storedLastStr ? parseInt(storedLastStr, 10) : Date.now();

            // Check immediately on load/restore if the user has been away longer than 15 minutes
            if (storedLastStr && (Date.now() - lastActivity >= IDLE_LOGOUT_MS)) {
              localStorage.removeItem('kindora_last_activity');
              window.location.href = '/auth/logout?reason=idle';
              return;
            }

            // Save initial valid timestamp if not existing
            if (!storedLastStr) {
              localStorage.setItem('kindora_last_activity', String(Date.now()));
            }

            let modalShown = false;
            let countdownInterval: any = null;

            const modal = document.getElementById('idle-warning-modal');
            const countdownEl = document.getElementById('idle-countdown');
            const extendBtn = document.getElementById('idle-extend-btn');

            function resetActivity() {
              lastActivity = Date.now();
              localStorage.setItem('kindora_last_activity', String(lastActivity));
              if (modalShown) {
                hideModal();
              }
            }

            function hideModal() {
              modalShown = false;
              if (modal) modal.classList.add('hidden');
              if (countdownInterval) clearInterval(countdownInterval);
            }

            function showModal() {
              modalShown = true;
              if (modal) modal.classList.remove('hidden');
              let remaining = COUNTDOWN_SEC;
              if (countdownEl) countdownEl.textContent = String(remaining);

              if (countdownInterval) clearInterval(countdownInterval);
              countdownInterval = setInterval(() => {
                remaining--;
                if (countdownEl) countdownEl.textContent = String(Math.max(0, remaining));
                if (remaining <= 0) {
                  clearInterval(countdownInterval);
                  window.location.href = '/auth/logout?reason=idle';
                }
              }, 1000);
            }

            // Listen for user activity
            const events = ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'];
            events.forEach((evt) => {
              window.addEventListener(evt, () => {
                if (!modalShown) {
                  resetActivity();
                }
              }, { passive: true });
            });

            // Check when tab/window regains focus or computer wakes up
            document.addEventListener('visibilitychange', () => {
              if (document.visibilityState === 'visible') {
                const stored = parseInt(localStorage.getItem('kindora_last_activity') || '0', 10);
                if (stored && (Date.now() - stored >= IDLE_LOGOUT_MS)) {
                  window.location.href = '/auth/logout?reason=idle';
                }
              }
            });

            // Sync activity across tabs
            window.addEventListener('storage', (e) => {
              if (e.key === 'kindora_last_activity' && e.newValue) {
                lastActivity = parseInt(e.newValue, 10);
                if (modalShown && (Date.now() - lastActivity < IDLE_WARN_MS)) {
                  hideModal();
                }
              }
            });

            // Check idle loop every 5 seconds
            setInterval(() => {
              const storedLast = parseInt(localStorage.getItem('kindora_last_activity') || '0', 10);
              if (storedLast > lastActivity) {
                lastActivity = storedLast;
              }

              const elapsed = Date.now() - lastActivity;

              if (elapsed >= IDLE_LOGOUT_MS) {
                window.location.href = '/auth/logout?reason=idle';
              } else if (elapsed >= IDLE_WARN_MS && !modalShown) {
                showModal();
              }
            }, 5000);

            if (extendBtn) {
              extendBtn.addEventListener('click', () => {
                resetActivity();
              });
            }
          })();
        </script>
      </div>
    )}
  </body>
</html>
